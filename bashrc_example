# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# ==========================================
# Custom Developer Prompt Configuration
# ==========================================

# Colors (Optimized for dark terminals)
GREEN='\[\033[1;32m\]'    # Bright Green
CYAN='\[\033[1;36m\]'     # Bright Cyan
YELLOW='\[\033[1;33m\]'   # Bright Yellow
MAGENTA='\[\033[1;35m\]'  # Bright Magenta
RED='\[\033[0;31m\]'      # Bright Red
RESET='\[\033[0m\]'

# Runs before every prompt
__build_prompt() {
    local EXIT_CODE=$?

    # 🌿 Git branch & dirty state (only runs in git repos for speed)
    local GIT_INFO=""
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        local BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
        local DIRTY=""
        if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
            DIRTY="${RED}✦${RESET}"
        fi
        GIT_INFO=" ${YELLOW}${BRANCH}${RESET}${DIRTY}"
    fi

    # 🐍 Virtual Environment (Python/Conda/Node)
    local VENV_INFO=""
    if [ -n "$VIRTUAL_ENV" ]; then
        VENV_INFO=" ${MAGENTA}($(basename "$VIRTUAL_ENV"))${RESET}"
    fi

    # 🔴 Exit Code (only shows when a command fails)
    local EXIT_INFO=""
    if [ $EXIT_CODE -ne 0 ]; then
        EXIT_INFO="${RED}[${EXIT_CODE}]${RESET} "
    fi

    # 🔨 Build the final prompt
    PS1="${EXIT_INFO}${GREEN}\u@\h${RESET}:${CYAN}\w${VENV_INFO}${GIT_INFO}\n${GREEN}❯ ${RESET}"
}

PROMPT_COMMAND=__build_prompt
